# AIOS environment identity (never commit real credentials)
APP_ENV=development
STAGING_SAFE_MODE=true

# Frontend-safe Supabase configuration for an isolated development environment
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side Supabase configuration (never expose service role to Vite/browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Non-production outbound safety
STAGING_ALLOWED_PHONE_NUMBERS=
STAGING_ALLOWED_EMAILS=
STAGING_EMAIL_REDIRECT_TO=
AUTOMATIONS_DRY_RUN=true
EXTERNAL_CRON_MODE=disabled
